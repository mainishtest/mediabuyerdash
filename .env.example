# Database (Neon / PostgreSQL)
# Get your connection string from https://neon.tech → your project → Connection Details
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=verify-full"

# NextAuth
# Generate NEXTAUTH_SECRET with: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# Meta / Facebook Ads (required for Meta integration)
# 1. Create a Meta app at https://developers.facebook.com
# 2. Add the Facebook Login product and set your redirect URI
# 3. Copy App ID and App Secret from App Settings → Basic
META_APP_ID="your_meta_app_id"
META_APP_SECRET="your_meta_app_secret"
# Redirect URI must be registered in Meta app → Facebook Login → Settings
META_REDIRECT_URI="http://localhost:3000/api/auth/meta/callback"
# Production example:
# META_REDIRECT_URI="https://your-domain.vercel.app/api/auth/meta/callback"

# Shopify Integration (required for Shopify OAuth and order sync)
# 1. Create a Shopify app at https://partners.shopify.com → Apps → Create app
# 2. Under "Configuration", add the callback URL to "Allowed redirection URL(s)"
# 3. Copy Client ID → SHOPIFY_APP_KEY, Client Secret → SHOPIFY_APP_SECRET
SHOPIFY_APP_KEY="your_shopify_app_key"
SHOPIFY_APP_SECRET="your_shopify_app_secret"
SHOPIFY_REDIRECT_URI="http://localhost:3000/api/auth/shopify/callback"
# Production: SHOPIFY_REDIRECT_URI="https://your-domain.vercel.app/api/auth/shopify/callback"

# AI Provider Execution (optional — for real mode in Creative Lab)
# Copy .env.example to .env.local and add keys to enable real provider execution.

# OpenAI (copy generation)
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-4o-mini"

# Anthropic (copy generation)
ANTHROPIC_API_KEY="sk-ant-..."
ANTHROPIC_MODEL="claude-3-5-haiku-20241022"

# Email / SMTP (required for notification delivery)
# Supports any SMTP provider: SendGrid, Postmark, Resend, Gmail, etc.
# If not set, emails are not sent but logged to the server console instead.
SMTP_HOST="smtp.sendgrid.net"
SMTP_PORT="587"
SMTP_USER="apikey"
SMTP_PASS="your-sendgrid-api-key"
SMTP_FROM="no-reply@youragency.com"
