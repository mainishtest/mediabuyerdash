# Database (Neon / PostgreSQL)
# Get your connection string from https://neon.tech → your project → Connection Details
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# NextAuth
# Generate NEXTAUTH_SECRET with: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# AI Provider Execution (optional — for real mode in Creative Lab)
# Copy .env.example to .env.local and add keys to enable real provider execution.

# OpenAI (copy generation)
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-4o-mini"

# Anthropic (copy generation)
ANTHROPIC_API_KEY="sk-ant-..."
ANTHROPIC_MODEL="claude-3-5-haiku-20241022"
