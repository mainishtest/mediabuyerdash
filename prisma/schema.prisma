// ---------------------------------------------------------------------------
// Creative Generation Job records
// ---------------------------------------------------------------------------

// One row per AI generation run. Tracks provider, mode, token usage, latency.
// Variants produced by this job are stored in CreativeDraftVariantRecord
// with generationJobId linking back here.
model CreativeGenerationJobRecord {
