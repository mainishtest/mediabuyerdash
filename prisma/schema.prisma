// ── Action Safety Policy ──────────────────────────────────────────────────────
//
// Governs what level of autonomy the system has for a given scope.
// Scopes: client | ad_account | campaign
// Inheritance: campaign > ad_account > client > system default (in evaluate.ts)
// Blocking is additive: if any scope blocks an action, the action is blocked.
model ActionSafetyPolicy {
  id          String  @id @default(cuid())
  workspaceId String
  scope       String  // client | ad_account | campaign
  scopeId     String  // clientAccountId | adAccountId | externalCampaignId

  // Autonomy mode for this scope.
  // recommend_only | prepare_only | approval_required | guarded_auto_execute | restricted
  autonomyMode String @default("approval_required")

  // JSON arrays of ActionType strings. Stored as String for Postgres compat.
  allowedActionTypes String @default("[]")  // explicit allow list
  blockedActionTypes String @default("[]")  // overrides allow (safe wins)
  approvalRequired   String @default("[]")  // requires human sign-off

  // JSON array of ActionConstraint objects (thresholds, limits, etc.)
  constraints String  @default("[]")

  notes    String?
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, scope, scopeId])
  @@index([workspaceId])
  @@index([scope, scopeId])
}

// ── Automation Audit Log ──────────────────────────────────────────────────────
//
// Unified audit trail covering every automation lifecycle event:
// recommended → prepared → approval_requested → approved/rejected/deferred →
// execution_started → execution_succeeded/failed → rollback state.
//
// Flat structure: nested objects (scope, actor, approval, execution, block,
// rollback) are stored as JSON blobs and parsed in lib/auditLog/persist.ts.
// Bridge functions in persist.ts also synthesise entries from existing
// AutoExecutionLog and ProposedAutomationAction rows for backward coverage.
model AutomationAuditLog {
  id              String   @id @default(cuid())
  workspaceId     String?
  clientAccountId String?
  clientName      String?

  // Event classification
  eventType       String   // AutomationEventType
  actionType      String   // pause_campaign | run_sync | budget_increase | etc.

  // Nested objects stored as JSON blobs
  scopeJson       String   @default("{}")  // AutomationEventScope
  actorJson       String   @default("{}")  // AutomationActor
  approvalJson    String?                  // AutomationApprovalRecord | null
  executionJson   String?                  // AutomationExecutionRecord | null
  blockJson       String?                  // AutomationBlockRecord | null
  rollbackJson    String   @default("{}")  // RollbackReadiness

  // Policy decision (flat — avoids an extra JSON parse for common display)
  policyDecision  String?  // allowed | blocked | approval_required | restricted
  policyReason    String?  // ActionSafetyReason

  // Related entity links for cross-navigation
  relatedActionId         String?  // ProposedAutomationAction.id
  relatedExecutionLogId   String?  // AutoExecutionLog.id

  notes       String?
  occurredAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([workspaceId])
  @@index([clientAccountId, occurredAt])
  @@index([eventType])
  @@index([actionType])
  @@index([relatedActionId])
}

// ── Governance Controls ───────────────────────────────────────────────────────

// Active emergency stop states.
// A stop prevents guarded auto-execution and surfaces a governance flag
// in the approval routing layer. Stops are explicitly cleared by operators.
model GovernanceStop {
  id          String    @id @default(cuid())
  workspaceId String
  scope       String    // global | client | ad_account | campaign | action_type
  scopeId     String    // entity ID, "global", or action type name
  reason      String
  stoppedBy   String?   // userId who triggered it
  isActive    Boolean   @default(true)
  expiresAt   DateTime?
  clearedAt   DateTime?
  clearedBy   String?   // userId who cleared it
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, isActive])
  @@index([scope, scopeId, isActive])
}

// Operator overrides — explicit, scoped, with reason and optional expiry.
// pause_scope        — pause all auto-execution in a scope
// require_approval_all — temporarily force approval for all actions in scope
// defer_action       — defer a specific proposed action
// override_block     — override a policy block where permitted (high-risk; requires reason)
// resume_scope       — explicitly resume a previously paused scope
model AutomationOverride {
  id            String    @id @default(cuid())
  workspaceId   String
  overrideType  String    // pause_scope | require_approval_all | defer_action | override_block | resume_scope
  scope         String    // global | client | ad_account | campaign | action_type
  scopeId       String
  actionId      String?   // if targeting a specific ProposedAutomationAction
  reason        String
  appliedBy     String?   // userId
  isActive      Boolean   @default(true)
  expiresAt     DateTime?
  clearedAt     DateTime?
  clearedBy     String?
  metadata      String    @default("{}") // JSON: additional context
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, isActive])
  @@index([scope, scopeId, isActive])
  @@index([actionId])
}

// ── Daily Brief ─────────────────────────────────────────────────────────────

