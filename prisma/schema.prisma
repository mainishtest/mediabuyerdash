  item       CreativeLabWorkflowItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  action     String
  fromStatus String?
  toStatus   String?
  note       String?
  createdAt  DateTime                @default(now())

  @@index([itemId])
}

// ---------------------------------------------------------------------------
// Creative Brief records
// ---------------------------------------------------------------------------

// Persists one generated brief per action triggered from the refresh queue.
// briefJson stores the assembled input + structured sections (no drafts).
// Draft variants are stored separately for individual review decisions.
model CreativeBriefRecord {
