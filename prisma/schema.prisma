// One row per generated draft variant. reviewDecision is set by the buyer.
model CreativeDraftVariantRecord {
  id              String              @id @default(cuid())
  briefId         String
  brief           CreativeBriefRecord @relation(fields: [briefId], references: [id], onDelete: Cascade)
  variantType     String
  title           String
  contentJson     String
  reviewDecision  String?
  reviewNote      String?
  reviewedAt      DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

