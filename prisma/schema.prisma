// Media Buying Dashboard — Prisma schema
// Production: PostgreSQL (Neon). Set DATABASE_URL in .env

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ── Auth & workspace ─────────────────────────────────────────────────────────

// Application user. Passwords are hashed with bcryptjs (salt 12).
// passwordHash is null for future OAuth-only users.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships            WorkspaceMembership[]
  passwordResetTokens    PasswordResetToken[]
  notificationPreference NotificationPreference?
  notificationLogs       NotificationLog[]
}

// Single-use password reset tokens. Expire after 1 hour.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// An agency workspace groups clients and users.
model Workspace {
  id              String   @id @default(cuid())
  name            String
  brandName       String?
  website         String?
  industry        String?
  timezone        String?
  monthlyAdSpend  Float?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  memberships          WorkspaceMembership[]
  clientAccounts       ClientAccount[]
  actionSafetyPolicies ActionSafetyPolicy[]
  governanceStops      GovernanceStop[]
  automationOverrides  AutomationOverride[]
  dailyBriefs          DailyBriefRecord[]
  onboardingState      OnboardingState?
}

// User ↔ Workspace with role. v1 roles: owner | manager.
model WorkspaceMembership {
  id          String   @id @default(cuid())
  userId      String
  workspaceId String
  role        String   @default("owner") // owner | manager
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
}

// ── Notification preferences & delivery log ───────────────────────────────────

// Per-user opt-in preferences for email notifications.
// Created with defaults on first access; updated by the user on /notifications.
model NotificationPreference {
  id                String   @id @default(cuid())
  userId            String   @unique
  emailEnabled      Boolean  @default(true)
  immediateAlerts   Boolean  @default(true)   // send high-priority alerts as they occur
  dailyDigest       Boolean  @default(true)   // send a daily summary email
  alertHighPriority Boolean  @default(true)   // include high-priority alert emails
  alertSyncFailure  Boolean  @default(true)   // include stale/failed sync alerts
  alertPacing       Boolean  @default(true)   // include pacing issue alerts
  alertBelowGoal    Boolean  @default(true)   // include campaigns-below-goal alerts
  alertMissingGoals Boolean  @default(false)  // include missing-goals recommendations
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Audit log for every notification attempted.
// deduplicationKey prevents double-sends for the same event + user.
model NotificationLog {
  id               String    @id @default(cuid())
  userId           String
  workspaceId      String?
  channel          String    @default("email")    // email (v1 only)
  eventType        String                          // immediate_alert | daily_digest
  priority         String    @default("medium")   // low | medium | high
  subject          String
  deduplicationKey String?
  status           String    @default("pending")  // pending | sent | failed | skipped
  errorMessage     String?
  sentAt           DateTime?
  createdAt        DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([workspaceId])
  @@index([deduplicationKey])
}

// ── Ad hierarchy ────────────────────────────────────────────────────────────

model ClientAccount {
  id          String   @id @default(cuid())
  workspaceId String?  // nullable for existing records; required for new ones
  name        String
  brandName   String?
  platform    String   @default("facebook")
  currency    String   @default("USD")
  timezone    String   @default("America/New_York")
  status      String   @default("active") // active | paused | archived
  notes       String?
  copywritingPrompt  String?  // Custom AI copywriting instructions for this client (tone, voice, rules, context)
  imagePromptDirections String? // Custom AI image generation instructions (style, mood, product placement, dos/donts)
  productImageUrl    String?  // Reference product image URL for AI image generation (keeps product consistent)
  // Ad campaign defaults — auto-fill into launch test setup
  defaultAdAccountId    String?  // Meta Ad Account ID (e.g. act_123456)
  defaultPageId         String?  // Facebook Page ID
  defaultPixelId        String?  // Meta Pixel ID for conversion tracking
  defaultDestinationUrl String?  // Landing page URL
  defaultHeadline       String?  // Default ad headline (shown below image in link ads)
  defaultDailyBudget    Float?   // Default daily budget in dollars
  defaultObjective      String?  // OUTCOME_TRAFFIC, OUTCOME_SALES, etc.
  defaultOptGoal        String?  // LINK_CLICKS, OFFSITE_CONVERSIONS, etc.
  defaultTargetCountries String? // Comma-separated: "US,CA,GB"
  defaultAgeMin         Int?     // Minimum target age
  defaultAgeMax         Int?     // Maximum target age
  defaultGender         Int?     // 0=all, 1=male, 2=female
  // UTM defaults
  defaultUtmSource      String?  // e.g. "facebook"
  defaultUtmMedium      String?  // e.g. "paid"
  defaultUtmCampaign    String?  // e.g. "{{campaign.name}}"
  defaultUtmContent     String?  // e.g. "{{ad.name}}"
  defaultUtmTerm        String?
  clientPortalToken        String? @unique  // shareable read-only token for client portal
  clientPortalPasswordHash String?          // bcrypt hash of admin-issued portal password (null = no password required)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace               Workspace?             @relation(fields: [workspaceId], references: [id])
  campaigns               Campaign[]
  utmPerformanceRows      UTMPerformanceRow[]
  crmPerformanceRows      CRMPerformanceRow[]
  reconciliationResults   ReconciliationResult[]
  reconciliationMatches   ReconciliationMatch[]
  reconciliationSummaries          ReconciliationSummary[]
  reconciledCampaignPerformances   ReconciledCampaignPerformance[]
  alertEvents                      AlertEvent[]
  proposedAutomationActions        ProposedAutomationAction[]
  metaSelectedAccounts             MetaSelectedAdAccount[]
  shopifyConnections      ShopifyConnection[]
  shopifyOrders           ShopifyOrder[]
  clientSyncRuns          ClientSyncRun[]
  goalDefaults            ClientGoalDefaults?
  budgetPacingTargets     BudgetPacingTarget[]
  autoExecutionSettings   AutoExecutionSettings?
  brandContext            BrandContext?
}

model Campaign {
  id          String   @id @default(cuid())
  accountId   String
  name        String
  objective   String   // conversions | traffic | reach | brand_awareness
  status      String   // active | paused | archived
  dailyBudget Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  account ClientAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  adSets  AdSet[]
  goals   CampaignGoal?
}

model CampaignGoal {
  id            String   @id @default(cuid())
  campaignId    String   @unique
  roasGoalType  String   // high | low
  roasGoalValue Float
  cpaGoalType   String
  cpaGoalValue  Float
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

model AdSet {
  id          String   @id @default(cuid())
  campaignId  String
  name        String
  targeting   String
  dailyBudget Float
  status      String
  startDate   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  ads      Ad[]
}

model Ad {
  id               String   @id @default(cuid())
  adSetId          String
  creativeId       String
  creativeAssetId  String?  // NEW: link to CreativeAsset (generated or imported)
  name             String
  status           String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  adSet          AdSet          @relation(fields: [adSetId], references: [id], onDelete: Cascade)
  creative       Creative       @relation(fields: [creativeId], references: [id])
  creativeAsset  CreativeAsset? @relation(fields: [creativeAssetId], references: [id])
}

model Creative {
  id           String   @id @default(cuid())
  name         String
  type         String   // image | video | carousel
  headline     String
  body         String
  callToAction String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ads Ad[]
}

// ── Meta connection ──────────────────────────────────────────────────────────

// One record per connected Meta user. In practice the app supports one active
// connection at a time.
// WARNING: accessToken is stored in plaintext. Encrypt with a KMS key before
// handling real production tokens.
model MetaConnection {
  id               String    @id @default(cuid())
  metaUserId       String    @unique
  userDisplayName  String
  connectionStatus String    @default("active") // active | expired | revoked
  accessToken      String
  tokenExpiresAt   DateTime?
  scopes           String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  accessibleAccounts MetaAccessibleAdAccount[]
  selectedAccounts   MetaSelectedAdAccount[]
  syncLogs           MetaSyncLog[]
}

// Ad accounts returned from /me/adaccounts. Refreshed on demand.
model MetaAccessibleAdAccount {
  id                  String   @id @default(cuid())
  metaConnectionId    String
  externalAdAccountId String   // Meta format: "act_XXXXXXXXXX"
  accountName         String
  accountStatus       Int      @default(1)
  currency            String   @default("USD")
  timezoneName        String   @default("UTC")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  connection      MetaConnection        @relation(fields: [metaConnectionId], references: [id], onDelete: Cascade)
  selectedAccount MetaSelectedAdAccount?

  @@unique([metaConnectionId, externalAdAccountId])
}

// The subset of accessible accounts the operator has selected for the dashboard.
model MetaSelectedAdAccount {
  id                    String   @id @default(cuid())
  metaConnectionId      String
  accessibleAdAccountId String   @unique
  clientAccountId       String?
  selectedAt            DateTime @default(now())

  connection          MetaConnection          @relation(fields: [metaConnectionId], references: [id], onDelete: Cascade)
  accessibleAdAccount MetaAccessibleAdAccount @relation(fields: [accessibleAdAccountId], references: [id], onDelete: Cascade)
  clientAccount       ClientAccount?          @relation(fields: [clientAccountId], references: [id])
}

// ── Reporting & reconciliation ────────────────────────────────────────────────

model UTMPerformanceRow {
  id              String   @id @default(cuid())
  clientAccountId String
  date            String
  campaignId      String?
  campaignName    String?
  adSetId         String?
  adSetName       String?
  adId            String?
  adName          String?
  utmCampaign     String?
  utmContent      String?
  utmTerm         String?
  utmSource       String?
  utmMedium       String?
  spend           Float
  impressions     Int
  clicks          Int
  conversions     Int
  revenue         Float
  cpa             Float
  roas            Float
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  clientAccount ClientAccount @relation(fields: [clientAccountId], references: [id])
}

model CRMConnection {
  id          String    @id @default(cuid())
  platform    String    // shopify | konnective
  label       String
  status      String    // connected | disconnected | pending | error
  storeUrl    String?
  apiEndpoint String?
  connectedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model CRMPerformanceRow {
  id                String   @id @default(cuid())
  clientAccountId   String
  date              String
  sourcePlatform    String   // shopify | konnective | other
  utmCampaign       String?
  utmContent        String?
  utmTerm           String?
  utmSource         String?
  utmMedium         String?
  orders            Int
  revenue           Float
  averageOrderValue Float
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  clientAccount ClientAccount @relation(fields: [clientAccountId], references: [id])
}

model ReconciliationResult {
  id               String   @id @default(cuid())
  clientAccountId  String
  date             String
  utmCampaign      String?
  utmContent       String?
  utmTerm          String?
  metaSpend        Float?
  metaConversions  Int?
  metaRevenue      Float?
  metaRoas         Float?
  crmOrders        Int?
  crmRevenue       Float?
  crmSource        String?
  revenueDelta     Float?
  revenueDeltaPct  Float?
  status           String   // matched | partial | mismatch | missing_crm | missing_meta
  statusReason     String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  clientAccount ClientAccount @relation(fields: [clientAccountId], references: [id])
}

// ── AI generation & approval ───────────────────────────────────────────────────

model AIGenerationJob {
  id               String    @id @default(cuid())
  entityType       String    // ad
  entityId         String    // adId
  requestType      String    // copy | image
  provider         String    // mock | openai | anthropic | image_provider_placeholder
  status           String    // idle | queued | running | completed | failed
  startedAt        DateTime  @default(now())
  completedAt      DateTime?
  errorMessage     String?
  responseSnapshot String?   // JSON string of generated variations/concepts
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  approvals CreativeApproval[]
}

model CreativeApproval {
  id          String   @id @default(cuid())
  jobId       String
  variationId String   // id of CopyVariation or ImageVariationConcept
  entityType  String   // copy | image
  adId        String
  status      String   // draft | approved | rejected
  approvedAt  DateTime?
  rejectedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  job AIGenerationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, variationId])
}

// ── Generation persistence & audit trail ────────────────────────────────────────

model GenerationRun {
  id              String    @id @default(cuid())
  clientAccountId  String?
  campaignId       String
  adSetId          String?
  adId             String
  adName           String
  requestType      String    // copy_generation | image_variation_generation
  provider         String    // openai_text | anthropic_text | image_provider_placeholder
  mode             String    // mock | real
  status           String    // completed | failed | partial
  createdAt        DateTime  @default(now())
  completedAt      DateTime?

  promptSnapshot    GenerationPromptSnapshot?
  providerRequest   GenerationProviderRequest?
  providerResponse  GenerationProviderResponse?
  copyVariations    GeneratedCopyVariation[]
  imageVariations   GeneratedImageVariation[]
  approvalDecisions GenerationApprovalDecision[]
  selectedVariants  SelectedCreativeVariant[]
}

model GenerationPromptSnapshot {
  id                 String   @id @default(cuid())
  generationRunId    String   @unique
  templateType       String
  templateVersion    String
  renderedPrompt     String
  contextSnapshotJson String
  createdAt          DateTime @default(now())

  run GenerationRun @relation(fields: [generationRunId], references: [id], onDelete: Cascade)
}

model GenerationProviderRequest {
  id               String   @id @default(cuid())
  generationRunId  String   @unique
  provider         String
  requestPayloadJson String
  createdAt        DateTime @default(now())

  run GenerationRun @relation(fields: [generationRunId], references: [id], onDelete: Cascade)
}

model GenerationProviderResponse {
  id                String   @id @default(cuid())
  generationRunId   String   @unique
  provider          String
  responsePayloadJson String
  executionStatus   String
  errorMessage      String?
  createdAt         DateTime @default(now())

  run GenerationRun @relation(fields: [generationRunId], references: [id], onDelete: Cascade)
}

model GeneratedCopyVariation {
  id             String   @id @default(cuid())
  generationRunId String
  title          String
  hook           String
  body           String
  callToAction   String
  approvalStatus String   @default("draft")  // draft | approved | rejected
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  run GenerationRun @relation(fields: [generationRunId], references: [id], onDelete: Cascade)
}

model GeneratedImageVariation {
  id              String   @id @default(cuid())
  generationRunId String
  title           String
  conceptSummary  String
  visualChanges   String
  goal            String
  approvalStatus  String   @default("draft")  // draft | approved | rejected
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  run GenerationRun @relation(fields: [generationRunId], references: [id], onDelete: Cascade)
}

model GenerationApprovalDecision {
  id              String   @id @default(cuid())
  generationRunId String
  variationType   String   // copy | image
  variationId     String   // id of GeneratedCopyVariation or GeneratedImageVariation
  decision        String   // approved | rejected
  notes           String?
  decidedAt       DateTime @default(now())
  createdAt       DateTime @default(now())

  run GenerationRun @relation(fields: [generationRunId], references: [id], onDelete: Cascade)
}

model SelectedCreativeVariant {
  id              String   @id @default(cuid())
  generationRunId String
  variationType   String   // copy | image
  variationId     String
  selectedAt      DateTime @default(now())
  createdAt       DateTime @default(now())

  run GenerationRun @relation(fields: [generationRunId], references: [id], onDelete: Cascade)

  @@unique([generationRunId, variationType])
}

// ── Test Launch Workflow ───────────────────────────────────────────────────────

// A launch draft packages one or more approved creative variants into a
// launch-ready test. It is NOT published to Meta yet; it is preparation only.
model LaunchDraft {
  id              String   @id @default(cuid())
  draftName       String
  clientAccountId String?
  campaignId      String
  adSetId         String?
  baseAdId        String
  baseAdName      String
  objectiveMetric String?
  source          String   // generated_copy | generated_image | generated_both | manual
  status          String   @default("draft") // draft | ready | archived
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  variants LaunchDraftVariant[]
}

// A single creative variant within a launch draft.
// Copy/image content is denormalized at creation for self-contained previews.
// copyVariationId / imageVariationId trace back to the generation audit trail.
model LaunchDraftVariant {
  id                  String   @id @default(cuid())
  launchDraftId       String
  copyVariationId     String?
  imageVariationId    String?
  variantName         String
  hook                String?
  body                String?
  callToAction        String?
  imageConceptTitle   String?
  imageConceptSummary String?
  selectedForLaunch   Boolean  @default(true)
  createdAt           DateTime @default(now())

  draft LaunchDraft @relation(fields: [launchDraftId], references: [id], onDelete: Cascade)
}

// ── Experiment results ────────────────────────────────────────────────────────

// An experiment pairs a control creative against a challenger creative and
// evaluates their performance over a defined window using CRM + Meta data.
// All IDs linking to Meta entities are stored as plain external-ID strings.
model ExperimentRecord {
  id               String   @id @default(cuid())
  clientAccountId  String
  campaignId       String?  // internal campaign reference (optional)
  name             String
  description      String?
  status           String   @default("active") // active | evaluating | completed | archived | failed
  comparisonMode   String   @default("simultaneous") // simultaneous | sequential

  // Control variant (existing / baseline creative)
  controlCreativeId      String?
  controlAdExternalId    String?
  controlAdSetExternalId String?
  controlCampaignExternalId String?
  controlLabel           String   @default("Control")

  // Challenger variant (newly launched creative)
  challengerPrepItemId       String?  // links to PublishPrepRecord.id
  challengerAdExternalId     String?
  challengerAdSetExternalId  String?
  challengerCampaignExternalId String?
  challengerLabel            String   @default("Challenger")

  // Shared ad account (needed for MetaSyncedInsight queries)
  externalAdAccountId String?

  // Success criteria
  primaryMetric            String   @default("roas_7d")
  secondaryMetrics         String?  // JSON array of metric keys
  successThreshold         Float    @default(0.10) // 10% relative lift
  minSpendPerVariant       Float    @default(50.0)
  minConversionsPerVariant Int      @default(5)
  evaluationWindowDays     Int      @default(7)

  // Evaluation window
  startedAt        DateTime  @default(now())
  evaluationEndsAt DateTime?
  completedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  results   ExperimentResultRecord[]
  learnings ExperimentLearningRecord[]

  @@index([clientAccountId])
  @@index([challengerPrepItemId])
  @@index([status])
}

// Stores the evaluated result of one experiment run.
// Re-evaluation overwrites the previous result row (upsert on experimentId).
model ExperimentResultRecord {
  id           String @id @default(cuid())
  experimentId String @unique  // one result per experiment at a time

  outcome        String  // ExperimentOutcome
  winningVariant String? // "control" | "challenger" | null
  confidence     Float   @default(0)

  // Raw snapshots (JSON: ExperimentMetricSnapshot)
  controlSnapshotJson    String?
  challengerSnapshotJson String?

  // Comparison summary
  primaryMetricDelta Float?
  primaryMetricLift  Float?
  guardrailBreaches  String?  // JSON array of strings
  outcomeReasons     String?  // JSON array of strings

  // Action guidance
  recommendedAction String?
  recommendedNote   String?
  learningSummary   String?

  evaluatedAt DateTime @default(now())

  experiment ExperimentRecord @relation(fields: [experimentId], references: [id], onDelete: Cascade)

  @@index([experimentId])
}

// Reusable learning extracted from a completed experiment.
// Tagged for reuse by Creative Lab brief generation and scoring.
model ExperimentLearningRecord {
  id              String @id @default(cuid())
  experimentId    String
  clientAccountId String

  // Tags for cross-workflow reuse
  briefIntent    String?  // matches CreativeBrief.intent
  draftType      String?  // matches CreativeBrief.draftType
  winningPattern String?  // short label for what drove the win

  outcomeLabel    String
  insightText     String   // 1-2 sentence learning, human-readable
  detailJson      String?  // JSON: key deltas, snippets, metrics

  usableForBriefs  Boolean @default(true)
  usableForScoring Boolean @default(true)

  createdAt DateTime @default(now())

  experiment ExperimentRecord @relation(fields: [experimentId], references: [id], onDelete: Cascade)

  @@index([clientAccountId])
  @@index([briefIntent])
  @@index([experimentId])
}

// ── Creative test results ────────────────────────────────────────────────────

// Tracks launched creative tests from the creative-lab perspective.
// Links to ExperimentRecord (experimentId) for raw evaluation data.
// Plain-string references used (no FK) to keep migration surface minimal.
model CreativeTestResultRecord {
  id               String  @id @default(cuid())
  clientAccountId  String
  name             String
  trackingState    String  @default("pending_launch")
  outcome          String?   // CreativeTestOutcome — null until first ingestion

  // Source links (plain strings)
  launchPlanId  String?   // ExperimentLaunchPlanRecord.id
  experimentId  String?   // ExperimentRecord.id
  prepItemId    String?   // PublishPrepRecord.id
  briefId       String?

  // Creative context (denormalised for self-contained display)
  controlCreativeId         String?
  controlCreativeName       String?
  controlAdExternalId       String?
  challengerVariantTitle    String?
  challengerAdExternalId    String?
  clientName                String?
  campaignName              String?
  adSetName                 String?
  externalAdAccountId       String?
  targetCampaignExternalId  String?
  targetAdSetExternalId     String?

  // Success criteria (copied from launch plan for self-contained evaluation)
  primaryMetric            String  @default("roas_7d")
  successThreshold         Float   @default(0.10)
  evaluationWindowDays     Int     @default(7)
  minSpendPerVariant       Float   @default(50.0)
  minConversionsPerVariant Int     @default(5)

  // Ingested performance snapshots (JSON: CreativeTestMetricSnapshot)
  controlSnapshotJson    String?
  challengerSnapshotJson String?

  // Evaluation outputs
  primaryMetricDelta Float?
  primaryMetricLift  Float?
  guardrailBreaches  String?  // JSON: string[]
  outcomeReasons     String?  // JSON: string[]
  confidence         Float?
  winningVariant     String?  // "control" | "challenger" | null

  // Evaluation window
  windowStartedAt  DateTime?
  windowEndsAt     DateTime?
  isWindowComplete Boolean   @default(false)

  // Recommended next action
  recommendedNextStep String?

  // Review state
  markedForReview Boolean   @default(false)
  archivedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lifecycleLinks CreativeLifecycleResultLinkRecord[]

  @@index([clientAccountId])
  @@index([launchPlanId])
  @@index([experimentId])
  @@index([trackingState])
  @@index([outcome])
}

// Explicit lifecycle attachment — wires a test result back to a source creative draft.
// One record per (testResultId, prepItemId) pair.
model CreativeLifecycleResultLinkRecord {
  id              String  @id @default(cuid())
  testResultId    String
  clientAccountId String

  // Back-links into creative lifecycle
  prepItemId   String?
  briefId      String?
  variantId    String?
  launchPlanId String?
  experimentId String?

  // Outcome context snapshot at time of attachment
  outcome     String?
  winningRole String?   // "control" | "challenger" | null
  confidence  Float?
  primaryLift Float?

  attachedAt DateTime @default(now())

  testResult CreativeTestResultRecord @relation(fields: [testResultId], references: [id], onDelete: Cascade)

  @@index([testResultId])
  @@index([prepItemId])
  @@index([clientAccountId])
}

// ── Creative outcome routing ──────────────────────────────────────────────────

// One record per CreativeTestResultRecord — built by buildCreativeOutcomeRoute()
// after ingestion. Stores the routing decision, extracted learning, and action state.
// Uses (prisma as any) in lib/ because the model is added via SQL migration.
model CreativeOutcomeRouteRecord {
  id               String  @id @default(cuid())
  clientAccountId  String
  testResultId     String  @unique   // 1:1 with CreativeTestResultRecord

  routeType       String              // CreativeOutcomeRouteType
  readinessState  String @default("pending_action")  // CreativeOutcomeReadinessState

  // Source context (denormalised)
  outcome         String?
  confidenceLevel String?
  confidenceScore Float?
  primaryLift     Float?
  winningVariant  String?

  // Creative context
  challengerVariantTitle String?
  controlCreativeName    String?
  campaignName           String?
  primaryMetric          String?

  // Route decision (JSON blobs)
  reasonsJson  String  @default("[]")    // JSON: CreativeOutcomeReason[]
  evidenceJson String  @default("{}")    // JSON: Record<string, unknown>
  learningJson String?                   // JSON: CreativeIterationLearning | null

  // Next action
  nextActionLabel String
  nextActionHint  String
  linkedWorkflow  String?
  learningSummary String?

  // Action state
  actionedAt DateTime?
  actionedBy String?
  actionNote String?
  archivedAt DateTime?

  // Back-links
  launchPlanId String?
  experimentId String?
  briefId      String?
  variantId    String?
  prepItemId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientAccountId])
  @@index([readinessState])
  @@index([routeType])
  @@index([testResultId])
}

// ── Experiment launch wiring ─────────────────────────────────────────────────

// Bridges an approved creative draft (PublishPrepRecord) into a structured
// experiment launch plan with control/challenger mapping, success criteria,
// guardrails, and readiness tracking.
// Does not hold an ExperimentRecord FK to minimise migration surface.
// linkedExperimentId is a plain string reference set when plan is launched.
model ExperimentLaunchPlanRecord {
  id               String   @id @default(cuid())
  clientAccountId  String
  name             String
  hypothesis       String?
  objective        String?

  // Source references (plain strings — no FK to keep migration minimal)
  prepItemId       String?   // PublishPrepRecord.id (challenger source)
  briefId          String?
  variantId        String?
  recommendationId String?

  // Readiness state (CreativeExperimentReadinessState)
  readinessState   String    @default("draft")

  // Control creative
  controlLabel              String    @default("Control")
  controlCreativeId         String?
  controlCreativeName       String?
  controlAdExternalId       String?
  controlAdSetExternalId    String?
  controlCampaignExternalId String?

  // Challenger (from publish-prep)
  challengerLabel              String    @default("Challenger")
  challengerCreativeName       String?
  challengerAdExternalId       String?
  challengerAdSetExternalId    String?
  challengerCampaignExternalId String?
  challengerBriefIntent        String?
  challengerBriefDraftType     String?
  challengerVariantTitle       String?
  challengerVariantType        String?
  challengerClientName         String?
  challengerCampaignName       String?

  // Target mapping
  targetCampaignId         String?
  targetCampaignName       String?
  targetCampaignExternalId String?
  targetAdSetId            String?
  targetAdSetName          String?
  targetAdSetExternalId    String?
  externalAdAccountId      String?
  comparisonMode           String    @default("simultaneous")

  // Success criteria
  primaryMetric            String    @default("roas_7d")
  secondaryMetricsJson     String?   // JSON: string[]
  guardrailMetricsJson     String?   // JSON: string[]
  successThreshold         Float     @default(0.10)
  minSpendPerVariant       Float     @default(50.0)
  minConversionsPerVariant Int       @default(5)
  evaluationWindowDays     Int       @default(7)

  // Notes and approval
  launchNotes  String?
  approvedAt   DateTime?
  approvedBy   String?

  // Link to ExperimentRecord when launched (plain string, no FK)
  linkedExperimentId String?
  launchedAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientAccountId])
  @@index([prepItemId])
  @@index([readinessState])
}

// ── Publish preparation ───────────────────────────────────────────────────────

// A publish prep record packages one approved creative draft variant into a
// validated, guardrail-checked launch plan ready for human-reviewed publication.
// briefId + variantId reference CreativeBriefRecord / CreativeDraftVariantRecord
// as plain strings (no FK) to keep migration surface minimal.
model PublishPrepRecord {
  id               String    @id @default(cuid())
  briefId          String
  variantId        String
  clientAccountId  String
  status           String    @default("draft")
  executionMode    String    @default("manual_publish")

  // Source snapshot (denormalised for self-contained display)
  variantTitle     String
  variantType      String    // copy | image
  briefIntent      String
  briefDraftType   String
  clientName       String
  campaignName     String?
  creativeName     String?

  // Target mapping
  targetCampaignId         String?
  targetCampaignName       String?
  targetCampaignExternalId String?
  targetAdSetId            String?
  targetAdSetName          String?
  targetAdSetExternalId    String?
  destinationUrl           String?
  ctaType                  String?

  // Payload + validation + guardrails (JSON blobs)
  payloadJson    String?   // PublishPayloadPreview
  validationJson String?   // PublishValidationResult
  guardrailJson  String?   // PublishGuardrailResult[]

  // Approval + publish state
  launchNotes        String?
  approvedForLaunch  Boolean   @default(false)
  approvedAt         DateTime?
  publishedAt        DateTime?
  publishError       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([briefId])
  @@index([variantId])
  @@index([clientAccountId])
}

// ── Meta sync ─────────────────────────────────────────────────────────────────

// Audit record for each sync run.
model MetaSyncLog {
  id                String    @id @default(cuid())
  metaConnectionId  String
  status            String    // running | completed | partial | failed
  accountsProcessed Int       @default(0)
  campaignsSynced   Int       @default(0)
  adSetsSynced      Int       @default(0)
  adsSynced         Int       @default(0)
  creativesSynced   Int       @default(0)
  insightRowsSynced Int       @default(0)
  errorMessages     String?   // JSON array of error strings
  startedAt         DateTime  @default(now())
  completedAt       DateTime?
  createdAt         DateTime  @default(now())

  connection MetaConnection @relation(fields: [metaConnectionId], references: [id], onDelete: Cascade)
}

// Campaigns synced from Meta. Upserted on externalCampaignId.
model MetaSyncedCampaign {
  id                  String    @id @default(cuid())
  workspaceId         String?   // set on sync; null for legacy rows
  externalAdAccountId String
  externalCampaignId  String    @unique
  name                String
  status              String
  objective           String?
  buyingType          String?
  metaCreatedAt       DateTime?
  metaUpdatedAt       DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  goal MetaCampaignGoal?

  @@index([workspaceId])
  @@index([workspaceId, externalAdAccountId])
}

// Internal dashboard goals for imported Meta campaigns.
// Stored in this app only — never written back to Meta Ads Manager.
// Keyed on externalCampaignId for direct, reliable linking (no name matching).
model MetaCampaignGoal {
  id                 String   @id @default(cuid())
  externalCampaignId String   @unique
  // Legacy fields — kept for backward compat with existing evaluation + alert code.
  roasGoalType       String   // "high" | "low"
  roasGoalValue      Float
  cpaGoalType        String   // "high" | "low"
  cpaGoalValue       Float
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  campaign MetaSyncedCampaign @relation(fields: [externalCampaignId], references: [externalCampaignId], onDelete: Cascade)

  @@index([externalCampaignId])
}

// Default ROAS and CPA goals for a client.
// Applied when a campaign has no explicit MetaCampaignGoal.
// One row per client — upserted, never duplicated.
model ClientGoalDefaults {
  id                   String   @id @default(cuid())
  clientAccountId      String   @unique
  // Legacy fields — kept for backward compat.
  defaultRoasGoalType  String   @default("high")  // "high" | "low"
  defaultRoasGoalValue Float
  defaultCpaGoalType   String   @default("low")   // "high" | "low"
  defaultCpaGoalValue  Float
  // Extended goal fields (Phase 3 goals system).
  targetRoas           Float?
  targetCpa            Float?
  targetCtr            Float?
  targetCvr            Float?
  maxDailySpend        Float?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  clientAccount ClientAccount @relation(fields: [clientAccountId], references: [id], onDelete: Cascade)
}

// Ad sets synced from Meta. Upserted on externalAdSetId.
model MetaSyncedAdSet {
  id                  String    @id @default(cuid())
  workspaceId         String?
  externalAdAccountId String
  externalCampaignId  String
  externalAdSetId     String    @unique
  name                String
  status              String
  metaCreatedAt       DateTime?
  metaUpdatedAt       DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([workspaceId])
  @@index([externalCampaignId])
  @@index([externalAdAccountId, externalCampaignId])
}

// Ads synced from Meta. Upserted on externalAdId.
model MetaSyncedAd {
  id                  String    @id @default(cuid())
  workspaceId         String?
  externalAdAccountId String
  externalCampaignId  String
  externalAdSetId     String
  externalAdId        String    @unique
  externalCreativeId  String?
  name                String
  status              String
  metaCreatedAt       DateTime?
  metaUpdatedAt       DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([workspaceId])
  @@index([externalAdSetId])
  @@index([externalCampaignId])
  @@index([externalAdAccountId, externalCampaignId])
}

// Creative metadata synced from Meta. Upserted on externalCreativeId.
model MetaSyncedCreative {
  id                 String   @id @default(cuid())
  workspaceId        String?
  externalCreativeId String   @unique
  name               String?
  title              String?
  body               String?
  callToAction       String?
  imageUrl           String?
  thumbnailUrl       String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([workspaceId])
}

// Daily insight rows. Refreshed (delete + recreate) on each sync for the
// synced date window. Empty-string defaults allow the compound unique key to
// work correctly in PostgreSQL even for nullable entity IDs.
model MetaSyncedInsight {
  id                  String  @id @default(cuid())
  workspaceId         String?
  externalAdAccountId String
  level               String  @default("ad") // campaign | adset | ad
  externalCampaignId  String  @default("")
  externalAdSetId     String  @default("")
  externalAdId        String  @default("")
  dateStart           String
  dateStop            String  @default("")
  spend               Float   @default(0)
  impressions         Int     @default(0)
  clicks              Int     @default(0)
  ctr                 Float?
  cpm                 Float?
  frequency           Float?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([externalAdAccountId, level, externalCampaignId, externalAdSetId, externalAdId, dateStart])
  @@index([externalAdAccountId, level, dateStart])
  @@index([workspaceId, dateStart])
  @@index([externalCampaignId, level, dateStart])
  @@index([externalAdSetId, level, dateStart])
}

// ── Shopify CRM integration ───────────────────────────────────────────────────

// One Shopify store connection per shop domain.
model ShopifyConnection {
  id               String    @id @default(cuid())
  workspaceId      String?   // set when connected from a workspace context
  clientAccountId  String?
  shopDomain       String    @unique // e.g. "mystore.myshopify.com"
  accessToken      String    // WARNING: encrypt in production
  clientId         String?   // Shopify app client ID (for auto token refresh)
  clientSecret     String?   // Shopify app client secret (for auto token refresh)
  connectionStatus String    @default("active") // active | disconnected | error
  scopes           String?
  installedAt      DateTime  @default(now())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  clientAccount ClientAccount? @relation(fields: [clientAccountId], references: [id])
  orders        ShopifyOrder[]
  syncLogs      ShopifySyncLog[]

  @@index([workspaceId])
}

// Shopify orders synced for the last 30 days. Upserted on externalOrderId.
model ShopifyOrder {
  id                  String   @id @default(cuid())
  workspaceId         String?  // set on sync; null for legacy rows
  shopifyConnectionId String
  clientAccountId     String?
  externalOrderId     String   // "gid://shopify/Order/12345"
  orderNumber         String   // "#1001"
  orderCreatedAt      DateTime
  currency            String
  totalPrice          Float    @default(0)
  subtotalPrice       Float    @default(0)
  totalTax            Float    @default(0)
  totalDiscount       Float    @default(0)
  customerId          String?
  customerEmail       String?
  utmSource           String?
  utmMedium           String?
  utmCampaign         String?
  utmContent          String?
  utmTerm             String?
  landingPage         String?
  referringSite       String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Cancellation & fulfilment status (synced from Shopify)
  cancelReason      String?
  cancelledAt       DateTime?
  financialStatus   String?
  fulfillmentStatus String?
  netRevenue        Float?
  refundTotal       Float?

  connection    ShopifyConnection    @relation(fields: [shopifyConnectionId], references: [id], onDelete: Cascade)
  clientAccount ClientAccount?       @relation(fields: [clientAccountId], references: [id])
  lineItems     ShopifyOrderLineItem[]
  refunds       ShopifyRefund[]

  @@unique([shopifyConnectionId, externalOrderId])
  @@index([shopifyConnectionId, orderCreatedAt])
  @@index([clientAccountId, orderCreatedAt])
  @@index([workspaceId, orderCreatedAt])
}

// Order line items. Deleted + recreated on every sync for the parent order.
model ShopifyOrderLineItem {
  id             String   @id @default(cuid())
  shopifyOrderId String
  productId      String?
  variantId      String?
  sku            String?
  title          String
  quantity       Int      @default(1)
  price          Float    @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  order ShopifyOrder @relation(fields: [shopifyOrderId], references: [id], onDelete: Cascade)
}

// ── Reconciliation Engine (v1) ────────────────────────────────────────────────

// One row per matched/unmatched pair per reconciliation run.
// matchStatus values: matched | partial | unmatched_meta | unmatched_crm | ambiguous
// evaluatedCpa  = metaSpend / crmOrders   (CRM is source of truth)
// evaluatedRoas = crmRevenue / metaSpend  (CRM is source of truth)
model ReconciliationMatch {
  id                   String    @id @default(cuid())
  clientAccountId      String
  date                 String    // ISO date
  attributionWindowDays Int      @default(7)
  matchKey             String    // composite: clientId|date|utmCampaign|utmContent|utmTerm
  // Meta entity refs (optional — absent for unmatched_crm rows)
  metaCampaignId       String?
  metaAdSetId          String?
  metaAdId             String?
  // UTM dimensions
  utmCampaign          String?
  utmContent           String?
  utmTerm              String?
  // Meta delivery metrics (source: Meta)
  metaSpend            Float     @default(0)
  metaClicks           Int?
  metaImpressions      Int?
  // CRM source-of-truth metrics (source: Shopify/CRM)
  crmOrders            Int       @default(0)
  crmRevenue           Float     @default(0)
  // Evaluated performance — CRM is source of truth
  evaluatedCpa         Float?    // metaSpend / crmOrders
  evaluatedRoas        Float?    // crmRevenue / metaSpend
  // Match quality
  matchStatus          String    // matched | partial | unmatched_meta | unmatched_crm | ambiguous
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  clientAccount ClientAccount @relation(fields: [clientAccountId], references: [id], onDelete: Cascade)

  @@unique([clientAccountId, matchKey])
  @@index([clientAccountId, date])
}

// Rolled-up summary across a date range for a client account.
// One record per (clientAccountId, dateFrom, dateTo) reconciliation run.
model ReconciliationSummary {
  id               String   @id @default(cuid())
  clientAccountId  String
  dateFrom         String
  dateTo           String
  totalMetaSpend   Float    @default(0)
  totalCrmRevenue  Float    @default(0)
  totalCrmOrders   Int      @default(0)
  evaluatedCpa     Float?   // totalMetaSpend / totalCrmOrders
  evaluatedRoas    Float?   // totalCrmRevenue / totalMetaSpend
  matchedRows      Int      @default(0)
  unmatchedRows    Int      @default(0)  // unmatched_meta + unmatched_crm
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  clientAccount ClientAccount @relation(fields: [clientAccountId], references: [id], onDelete: Cascade)

  @@unique([clientAccountId, dateFrom, dateTo])
  @@index([clientAccountId, dateFrom])
}

// Per-campaign reconciliation rollup. One row per (client, campaign, date range).
// Aggregates UTM-matched + window-fallback attributed orders into CRM-verified
// ROAS and CPA metrics. Upserted on each reconciliation run.
model ReconciledCampaignPerformance {
  id                    String   @id @default(cuid())
  clientAccountId       String
  externalCampaignId    String
  campaignName          String
  dateFrom              String   // YYYY-MM-DD
  dateTo                String   // YYYY-MM-DD
  metaSpend             Float    @default(0)
  attributedRevenue     Float    @default(0)  // CRM revenue (source of truth)
  attributedOrders      Int      @default(0)  // CRM order count
  calculatedRoas        Float?                // attributedRevenue / metaSpend
  calculatedCpa         Float?                // metaSpend / attributedOrders
  utmMatchedOrders      Int      @default(0)  // orders via exact UTM path
  windowMatchedOrders   Int      @default(0)  // orders via 7-day lookback fallback
  attributionWindowDays Int      @default(7)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  clientAccount ClientAccount @relation(fields: [clientAccountId], references: [id], onDelete: Cascade)

  @@unique([clientAccountId, externalCampaignId, dateFrom, dateTo])
  @@index([clientAccountId, dateFrom])
}

// Alert events detected by the anomaly detection engine.
// Created/updated on each detection run; dismissed by user action.
model AlertEvent {
  id                String    @id @default(cuid())
  workspaceId       String?
  clientAccountId   String
  clientName        String
  alertType         String    // AlertType values
  severity          String    // AlertSeverity values
  status            String    @default("open") // open | acknowledged | resolved
  source            String    // AlertSource values
  entityType        String    // "client" | "campaign" | "integration"
  entityId          String
  entityName        String
  summary           String
  supportingMetrics String    @default("{}") // JSON-encoded Record<string,string|number>
  deduplicationKey  String    // {clientId}:{alertType}:{entityId} — used for upsert logic
  detectedAt        DateTime  @default(now())
  lastDetectedAt    DateTime  @default(now())
  acknowledgedAt    DateTime?
  resolvedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  clientAccount ClientAccount @relation(fields: [clientAccountId], references: [id], onDelete: Cascade)

  @@index([clientAccountId, status])
  @@index([status, severity])
  @@index([workspaceId, status])
  @@index([deduplicationKey])
}

// ── Client-scoped sync runs ───────────────────────────────────────────────────

// One record per client sync operation (meta | shopify | full).
model ClientSyncRun {
  id              String    @id @default(cuid())
  clientAccountId String
  syncType        String    // meta | shopify | full
  status          String    // running | completed | failed | partial
  startedAt       DateTime  @default(now())
  completedAt     DateTime?
  errorMessage    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  clientAccount ClientAccount      @relation(fields: [clientAccountId], references: [id], onDelete: Cascade)
  steps         ClientSyncRunStep[]

  @@index([clientAccountId, startedAt])
}

// Individual step within a sync run (one per data source synced).
model ClientSyncRunStep {
  id              String    @id @default(cuid())
  clientSyncRunId String
  stepType        String    // meta_account | shopify_orders
  status          String    // running | completed | failed | partial
  summaryJson     String?   // JSON: counts per step type
  errorMessage    String?
  startedAt       DateTime  @default(now())
  completedAt     DateTime?

  syncRun ClientSyncRun @relation(fields: [clientSyncRunId], references: [id], onDelete: Cascade)
}

// ── Shopify sync log ──────────────────────────────────────────────────────────

// Audit log for each sync run.
model ShopifySyncLog {
  id                  String    @id @default(cuid())
  shopifyConnectionId String
  status              String    // running | completed | partial | failed
  ordersSynced        Int       @default(0)
  lineItemsSynced     Int       @default(0)
  errorMessages       String?   // JSON array
  startedAt           DateTime  @default(now())
  completedAt         DateTime?
  createdAt           DateTime  @default(now())

  connection ShopifyConnection @relation(fields: [shopifyConnectionId], references: [id], onDelete: Cascade)
}

// ── Creative Lab: uploaded image creatives ────────────────────────────────────

// An image file uploaded by the user for creative analysis and iteration.
model UploadedCreativeImage {
  id               String   @id @default(cuid())
  workspaceId      String?
  clientAccountId  String?
  fileName         String
  mimeType         String
  fileSize         Int      // bytes
  storagePath      String   // relative path, e.g. "/uploads/creatives/[id].jpg"
  uploadedAt       DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  sourceCallToAction String?
  sourceCopy         String?

  analysis   UploadedCreativeAnalysis?
  iterations GeneratedImageIterationConcept[]

  @@index([workspaceId])
  @@index([clientAccountId])
}

// First-pass analysis of an uploaded creative image.
// Deterministic/mock in v1. Swap analysisEngine for real AI next step.
model UploadedCreativeAnalysis {
  id                              String   @id @default(cuid())
  uploadedCreativeImageId         String   @unique
  analysisStatus                  String   @default("pending") // pending | completed | failed
  analysisEngine                  String   @default("mock_v1") // mock_v1 | vision_api
  visualHeadline                  String?  // inferred headline or focal text
  detectedStyle                   String?  // e.g. "product-focus", "lifestyle", "text-heavy"
  dominantMessage                 String?  // e.g. "discount offer", "product benefit"
  visualTheme                     String?  // e.g. "minimalist", "busy", "high-contrast"
  clarityScore                    Int?     // 1-10: how readable is the main message
  attentionScore                  Int?     // 1-10: how likely to stop the scroll
  directResponseObservationsJson  String?  // JSON array of observation strings
  createdAt                       DateTime @default(now())
  updatedAt                       DateTime @updatedAt

  image UploadedCreativeImage @relation(fields: [uploadedCreativeImageId], references: [id], onDelete: Cascade)
}

// A generated image iteration concept for a given uploaded creative.
// v1: deterministic. v2: AI-generated real image edits.
model GeneratedImageIterationConcept {
  id                    String   @id @default(cuid())
  uploadedCreativeImageId String
  title                 String
  conceptSummary        String
  visualChanges         String
  goal                  String
  directResponseAngle   String?  // e.g. "stronger offer clarity"
  approvalStatus        String   @default("draft") // draft | approved | rejected
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  image UploadedCreativeImage @relation(fields: [uploadedCreativeImageId], references: [id], onDelete: Cascade)

  @@index([uploadedCreativeImageId])
}

// ── Automation Rules ──────────────────────────────────────────────────────────

// A named rule that triggers proposed automation actions.
// Rules are evaluated deterministically against existing system state.
// v1: built-in rule types only. v2: user-defined rules.
model AutomationRule {
  id          String   @id @default(cuid())
  workspaceId String?
  name        String
  description String
  ruleType    String   // pause_campaign_below_goal | increase_budget_above_goal | stale_sync | creative_fatigue | missing_integration | weak_roas
  isActive    Boolean  @default(true)
  priority    String   @default("medium") // low | medium | high
  conditions  String   @default("{}") // JSON: rule condition parameters
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  proposedActions ProposedAutomationAction[]

  @@index([workspaceId])
}

// A proposed automation action generated by a rule evaluation.
// Actions are recommendations only — approval does NOT yet write back to Meta.
// Status flow: proposed → approved | rejected | deferred | escalated; approved → executed | expired
model ProposedAutomationAction {
  id               String    @id @default(cuid())
  workspaceId      String?
  clientAccountId  String
  clientName       String
  automationRuleId String?
  actionType       String    // pause_campaign | reduce_budget | increase_budget | review_creative | refresh_creative | run_sync | investigate_client
  status           String    @default("proposed") // proposed | approved | rejected | executed | expired | deferred | escalated
  priority         String    @default("medium")   // low | medium | high
  entityType       String    // campaign | client | integration
  entityId         String
  entityName       String
  rationale        String
  supportingData   String    @default("{}") // JSON: metrics that triggered the rule
  deduplicationKey String    // "{clientId}:{actionType}:{entityId}"
  proposedAt       DateTime  @default(now())
  expiresAt        DateTime?
  approvedAt       DateTime?
  rejectedAt       DateTime?
  rejectionReason  String?
  // Governance fields — set by defer/escalate operations
  deferredUntil    DateTime? // when the deferral period ends (null = indefinite)
  escalatedAt      DateTime? // when the action was escalated
  escalationNote   String?   // reason provided at escalation time
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  rule   AutomationRule? @relation(fields: [automationRuleId], references: [id])
  client ClientAccount   @relation(fields: [clientAccountId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([clientAccountId])
  @@index([deduplicationKey])
  @@index([status])
}

// ── Auto-Execution ────────────────────────────────────────────────────────────

// Per-client opt-in settings for guarded auto-execution.
// Disabled by default — operators must explicitly enable per client.
model AutoExecutionSettings {
  id                 String   @id @default(cuid())
  clientAccountId    String   @unique
  workspaceId        String?
  enabled            Boolean  @default(false)  // master switch — off by default
  allowRunSync       Boolean  @default(true)   // permit auto run_sync
  allowPauseCampaign Boolean  @default(false)  // permit auto pause_campaign
  maxDailyExecutions Int      @default(5)      // hard cap per day per client
  maxSpendThreshold  Float    @default(500)    // pause: campaign must have spent ≥ this (USD)
  minRoasThreshold   Float    @default(0.4)    // pause: ROAS must be ≤ goal × this factor
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  clientAccount ClientAccount @relation(fields: [clientAccountId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

// Audit log for every auto-execution attempt (success, fail, or guardrail block).
model AutoExecutionLog {
  id              String   @id @default(cuid())
  workspaceId     String?
  clientAccountId String?
  actionType      String   // run_sync | pause_campaign
  entityType      String   // campaign | client
  entityId        String
  entityName      String
  status          String   // pending | success | failed | skipped | guardrail_blocked
  guardrailJson   String   @default("[]")  // JSON: GuardrailResult[]
  decision        String   // execute | skip | block
  decisionReason  String
  durationMs      Int?
  errorMessage    String?
  executedAt      DateTime @default(now())
  createdAt       DateTime @default(now())

  @@index([workspaceId])
  @@index([clientAccountId, executedAt])
  @@index([status])
}

// ── Budget Pacing ─────────────────────────────────────────────────────────────

// Monthly (and optional daily) budget targets for a client or campaign.
// campaignId = null  → client-level target (one per client at most)
// campaignId = set   → campaign-level target (one per campaign at most)
// Application-level upsert used instead of @@unique due to nullable campaignId.
model BudgetPacingTarget {
  id              String   @id @default(cuid())
  clientAccountId String
  campaignId      String?  // null = client-level; externalCampaignId = campaign-level
  monthlyBudget   Float
  dailyBudget     Float?   // explicit daily override; if null, implied = monthly / daysInMonth
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  clientAccount ClientAccount @relation(fields: [clientAccountId], references: [id], onDelete: Cascade)

  @@index([clientAccountId])
  @@index([clientAccountId, campaignId])
}

// ---------------------------------------------------------------------------
// Creative Lab workflow persistence
// ---------------------------------------------------------------------------

// Persists the mutable workflow state for a Creative Lab item.
// id is deterministic: cl_{clientAccountId}_{creativeId}_{campaignId}
// Performance context is always loaded fresh from the Meta sync pipeline.
model CreativeLabWorkflowItem {
